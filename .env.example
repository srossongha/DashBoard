# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram OIDC (get from BotFather -> Login Widget)
TELEGRAM_CLIENT_ID=your-bot-numeric-id
TELEGRAM_CLIENT_SECRET=your-oidc-client-secret
TELEGRAM_BOT_TOKEN=your-bot-token

# Session signing key (generate: openssl rand -base64 32)
SESSION_SECRET=your-random-32-byte-base64-string

# App public URL (no trailing slash)
APP_URL=https://your-worker.workers.dev

# Bootstrap: Telegram numeric ID of the first admin
INITIAL_ADMIN_TELEGRAM_ID=
